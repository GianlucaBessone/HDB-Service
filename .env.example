# ═══════════════════════════════════════════════════════
# BASE DE DATOS (PostgreSQL / Supabase)
# ═══════════════════════════════════════════════════════
# URL de conexión con Connection Pooling (Transaction Mode - puerto 6543 o pgbouncer)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# URL de conexión directa (Session Mode - puerto 5432, requerida para migraciones de Prisma)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ═══════════════════════════════════════════════════════
# AUTENTICACIÓN (Supabase Auth)
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Clave Service Role (exclusiva del backend para gestión de usuarios)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ═══════════════════════════════════════════════════════
# FIRMAS DIGITALES Y SEGURIDAD CRIPTOGRÁFICA
# ═══════════════════════════════════════════════════════
# Clave AES-256 de 32 bytes en formato hexadecimal (exactamente 64 caracteres hex)
# Generar con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SIGNATURE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ═══════════════════════════════════════════════════════
# NOTIFICACIONES PUSH (OneSignal)
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_API_KEY="your-onesignal-rest-api-key"

# ═══════════════════════════════════════════════════════
# APLICACIÓN Y TAREAS PROGRAMADAS (Cronjobs)
# ═══════════════════════════════════════════════════════
APP_URL="http://localhost:3000"
CRON_SECRET="generate-a-secure-random-string-for-cron-auth"
